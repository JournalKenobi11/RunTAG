{
  "mcpServers": {
    "runtag": {
      "command": "python3",
      "args": [
        "/path/to/RunTAG/dreeve_mcp.py"
      ],
      "env": {
        "PYTHONPATH": "/path/to/RunTAG",
        "DREEVE_DB_PATH": "/path/to/dreeve/storage/database/dreeve.db",
        "DREEVE_OUTPUT_DIR": "/path/to/RunTAG/output"
      }
    }
  }
}
